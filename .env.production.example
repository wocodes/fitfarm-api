# FitCloud API — production environment template
# Copy values into GitHub secrets; the deploy workflow writes this to the server.
APP_NAME=FitFarmHQ
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.fitfarmhq.com
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# MySQL (Hostinger hPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitcloud
DB_USERNAME=fitcloud_user
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email — switch from log to a transactional provider before launch
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@fitfarmhq.com
MAIL_FROM_NAME=FitCloud

# Domain controller — used to generate per-gym subdomain URLs
PLATFORM_DOMAIN=fitfarmhq.com
# Overrides (optional) for the per-gym URL generation:
# ADMIN_APP_URL=https://admin.fitfarmhq.com
# MEMBER_APP_URL=https://fitfarmhq.com

# CORS — exact allowed origins (wildcard subdomains are matched via patterns in config/cors.php)
CORS_ALLOWED_ORIGINS=https://fitfarmhq.com,https://admin.fitfarmhq.com

# Paystack — test keys today, replace with live keys at launch
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_MERCHANT_EMAIL=billing@fitfarmhq.com
FITCLOUD_PLATFORM_FEE_PERCENTAGE=1.0
# When true, member purchases are verified against Paystack before activation.
PAYSTACK_VERIFY_REFERENCES=true

VITE_APP_NAME=FitFarmHQ
# Platform super admin (only used by `php artisan db:seed`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_PASSWORD=

# Optional comma-separated regex patterns for custom gym domains
CORS_ALLOWED_ORIGIN_PATTERNS=

# Sanctum bearer-token lifetime in minutes (7 days)
SANCTUM_EXPIRATION=10080
