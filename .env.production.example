# FitFarmHQ API — production environment template
# Copy values into GitHub secrets; the deploy workflow writes this to the server.
APP_NAME=FitFarmHQ
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.fitfarmhq.com
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# MySQL (Hostinger hPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitcloud
DB_USERNAME=fitcloud_user
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email — switch from log to a transactional provider before launch
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@fitfarmhq.com
MAIL_FROM_NAME=FitFarmHQ

# Domain controller — used to generate per-gym subdomain URLs
PLATFORM_DOMAIN=fitfarmhq.com
# Overrides (optional) for the per-gym URL generation:
# ADMIN_APP_URL=https://admin.fitfarmhq.com
# MEMBER_APP_URL=https://fitfarmhq.com

# CORS — exact allowed origins (wildcard subdomains are matched via patterns in config/cors.php)
CORS_ALLOWED_ORIGINS=https://fitfarmhq.com,https://admin.fitfarmhq.com

# Bachs — sandbox or live API key and webhook signing secret
BACHS_SECRET_KEY=sk_live_xxxxxxxx
BACHS_WEBHOOK_SECRET=the_exact_live_webhook_signing_secret
BACHS_BASE_URL=https://api.bachs.io
BACHS_CURRENCY=NGN
# Demo gyms always use sandbox checkout credentials.
BACHS_DEMO_SECRET_KEY=
BACHS_DEMO_BASE_URL=https://sandbox-api.bachs.io
BACHS_DEMO_WEBHOOK_SECRET=

# Demo lifecycle
DEMO_DURATION_DAYS=30
DEMO_GRACE_DAYS=7
FITCLOUD_PLATFORM_FEE_PERCENTAGE=1.0

VITE_APP_NAME=FitFarmHQ
# Platform super admin (only used by `php artisan db:seed`)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_PASSWORD=

# Optional comma-separated regex patterns for custom gym domains
CORS_ALLOWED_ORIGIN_PATTERNS=

# Sanctum bearer-token lifetime in minutes (7 days)
SANCTUM_EXPIRATION=10080
